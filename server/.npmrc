# rate-limit-redis@5 déclare un peer express-rate-limit >= 8.5.0, or l'app tourne
# (et teste vert) sur express-rate-limit@7.x. Le couple fonctionne au runtime ;
# on tolère donc le peer non satisfait pour que `npm ci` (strict) passe en CI
# comme en local. TODO fix/payments-security : aligner les versions
# (rate-limit-redis@^4 compatible v7, OU bump express-rate-limit@^8) puis retirer.
legacy-peer-deps=true
